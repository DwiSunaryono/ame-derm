# Copy this file to .env and point it at your own local dataset/checkpoint layout.
# All variables are optional; defaults match the paths used to produce the paper's results.

# Root directory the PanDerm-comparison scripts (ame_derm/panderm_comparison/) resolve
# checkpoints and fold CSVs against. Defaults to the repo root.
AME_DERM_ROOT=

# Phase-1 segmentation crops consumed by every downstream classifier script.
CROP_DIR=BIRNet_Research/outputs/cropped_phase1_final

# BCN20000 external-validation cohort (see docs/DATA_PREPARATION.md).
BCN_CSV=panderm_datasets/BCN20000/BCN20000/bcn20000.csv
BCN_IMG=panderm_datasets/BCN20000/BCN20000/images
